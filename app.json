{
  "expo": {
    "name": "Muaythai Trainer",
    "slug": "muaythai-trainer",
    "version": "0.1.0",
    "scheme": "muaythai",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.muaythai.trainer"
    },
    "android": {
      "package": "com.muaythai.trainer",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70ee1495-3325-46fc-adb6-3145c06797cb"
      }
    }
  }
}
